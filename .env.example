MODEL_CAUTION_LEAD_SECONDS=1440
MODEL_EVACUATE_LEAD_SECONDS=600
MODEL_WINDOW_SAMPLES=12
ENABLE_RULE_ENGINE=true
# JSON array; thresholds are site-configured, not built-in safety limits.
RULES_JSON=[]
