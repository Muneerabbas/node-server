HOST=0.0.0.0
PORT=3000
DATABASE_PATH=./data/mine.db
MINE_ID=MINE-001
MINE_NAME=Mine Alpha
MINE_DESCRIPTION=
MINE_LOCATION=
DEVICE_OFFLINE_TIMEOUT_SECONDS=60
DEVICE_AUTH_ENABLED=false
REJECT_UNKNOWN_DEVICES=true
DASHBOARD_AUTH_TOKEN=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
ML_ENABLED=true
ML_MODEL_PATH=./models/risk-trend.js
ML_INFERENCE_TIMEOUT_MS=5000
